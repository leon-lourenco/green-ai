#!/usr/bin/env python3
"""Launcher for Virtual Garden (Antigravity agy)."""

import os
import sys

if sys.version_info < (3, 8):
    sys.exit(0)

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), os.pardir, "src"))

from virtual_garden.adapters.agy import main  # noqa: E402

sys.exit(main())
